<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_inherit_custom" model="ir.ui.view">
        <field name="name">product.template.form.inherit.custom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <group string="Informasi Tambahan Zahasky">
                    <field name="x_product_type"/>
                    <field name="x_series"/>
                    <field name="x_designer_name"/>
                    <field name="x_designer_role"/>
                    <field name="x_file_format"/>
                    <field name="x_file_size"/>
                    <field name="x_stock"/>
                    <field name="x_digital_file_url" widget="url"/>
                    <field name="x_product_description"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
